{
  "name": "validator-ops-skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.3",
  "workspaces": [
    "src/skills/jito-bam-boost",
    "src/skills/validator-revenue",
    "src/skills/votex-roi-sim"
  ],
  "scripts": {
    "test": "bun test ./src/skills ./tooling",
    "typecheck": "tsc --noEmit",
    "onboard": "bun src/skills/onboarding/scripts/onboard.ts",
    "performance": "bun src/skills/validator-performance/scripts/performance.ts",
    "revenue": "bun src/skills/validator-revenue/scripts/revenue.ts",
    "test:python": ".venv/bin/python -m unittest discover -s src/skills/sfdp-check/tests",
    "release:check": "bun tooling/release.ts --check",
    "validate": "bun run test && bun run typecheck && bun run test:python && bun run skills:check && bun run release:check",
    "skills:build": "bun tooling/skills.ts --write",
    "skills:check": "bun tooling/skills.ts --check",
    "test:install": "bun tooling/install-smoke.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "26.5.1",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "dependencies": {
    "@solana/web3.js": "1.98.4"
  }
}
